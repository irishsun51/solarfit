# 환경변수 / API 키 (절대 커밋 금지) — ini/.env 포함 (.env 파일명은 어느 경로든 무시)
.env
*.env.local
# .env.example(키 없는 템플릿)은 커밋됨

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 데이터 — 원본·가공 (외부 재다운로드 가능, 대용량). data/eval/ 는 포함(골드셋·평가결과)
data/raw/
data/processed/
data/일사량/
data/행정코드/
data/SMP_REC/

# DB — LIVE 벡터(chroma) + SQLite. git 대신 Google Drive로 별도 공유
db/
*.db
*.db-journal

# IDE
.vscode/
.idea/
*.swp

# OS
Thumbs.db
.DS_Store

# 로그 (log/ 내용은 무시, 폴더는 .gitkeep로 유지)
*.log
log/*.txt

# 배포용 압축 (Drive 업로드용 — git 금지)
*.zip
